<svg xmlns="http://www.w3.org/2000/svg" viewBox="-1 7 56 17" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="overflow: visible">
    <style>
        .logo-wire { stroke-dasharray: 10; stroke-dashoffset: 10; }
        .logo-wire-in { animation: logo-draw .45s ease-out both; }
        .logo-wire-out { animation: logo-draw .4s ease-out 1.4s both; }
        .logo-token { opacity: 0; }
        .logo-token-in { fill: #8a8a8a; animation: logo-token-in .9s linear .3s both; }
        .logo-token-out { fill: #D97757; animation: logo-token-out .8s ease-out 1.45s both; }
        .logo-creature { transform-box: fill-box; transform-origin: 50% 100%; animation: logo-hop .8s ease-in-out 1.1s both; }
        .logo-lid { fill: #D97757; transform-box: fill-box; transform-origin: 50% 0%; transform: scaleY(0); animation: logo-blink 4.5s ease-in-out 2.2s infinite; }
        @@keyframes logo-draw { from { stroke-dashoffset: 10; } to { stroke-dashoffset: 0; } }
        @@keyframes logo-token-in {
            0% { transform: translateX(0); opacity: 0; }
            10% { opacity: 1; }
            85% { opacity: 1; }
            100% { transform: translateX(14px); opacity: 0; }
        }
        @@keyframes logo-token-out {
            0% { transform: translateX(0); opacity: 0; }
            10% { opacity: 1; }
            80% { opacity: 1; }
            100% { transform: translateX(12px); opacity: 0; }
        }
        @@keyframes logo-hop {
            0%, 100% { transform: translateY(0) scale(1, 1); }
            25% { transform: translateY(0) scale(1.14, .84); }
            55% { transform: translateY(-3px) scale(.92, 1.12); }
            78% { transform: translateY(0) scale(1.06, .95); }
        }
        @@keyframes logo-blink {
            0%, 91%, 100% { transform: scaleY(0); }
            95% { transform: scaleY(1); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .logo-wire { stroke-dashoffset: 0; animation: none; }
            .logo-token, .logo-creature, .logo-lid { animation: none; }
            .logo-lid { transform: scaleY(0); }
        }
    </style>
    <line class="logo-wire logo-wire-in" x1="0" y1="15" x2="10" y2="15" stroke="#D97757" />
    <polyline class="logo-wire logo-wire-in" points="7,12 10,15 7,18" stroke="#D97757" />
    <g transform="translate(15,3)">
        <g class="logo-creature">
            <path clip-rule="evenodd" fill-rule="evenodd" fill="#D97757" d="M20.998 10.949H24v3.102h-3v3.028h-1.487V20H18v-2.921h-1.487V20H15v-2.921H9V20H7.488v-2.921H6V20H4.487v-2.921H3V14.05H0V10.95h3V5h17.998v5.949zM6 10.949h1.488V8.102H6v2.847zm10.51 0H18V8.102h-1.49v2.847z" />
            <rect class="logo-lid" x="6" y="8.102" width="1.488" height="2.847" />
            <rect class="logo-lid" x="16.51" y="8.102" width="1.49" height="2.847" />
        </g>
    </g>
    <line class="logo-wire logo-wire-out" x1="44" y1="15" x2="54" y2="15" stroke="#D97757" />
    <polyline class="logo-wire logo-wire-out" points="51,12 54,15 51,18" stroke="#D97757" />
    <circle class="logo-token logo-token-in" cx="0" cy="15" r="1.6" />
    <circle class="logo-token logo-token-out" cx="40" cy="15" r="1.6" />
</svg>
