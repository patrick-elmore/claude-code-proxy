{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/proxy_.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Proxy": {
    "Enabled": true,
    "PromptFilePath": "prompts/default.md",
    "VertexBaseUrl": "https://aiplatform.googleapis.com/v1",
    "AnthropicBaseUrl": "https://api.anthropic.com",
    "Variables": {}
  },
  "HeaderDump": {
    "Enabled": false
  },
  "Dump": {
    "Enabled": false,
    "FailureDumpEnabled": false,
    "MaxRequests": 5,
    "OutputPath": "<set-to-a-writable-directory>"
  },
  "Stats": {
    "OutputPath": "./stats"
  }
}
